# AI Provider - DeepSeek (default, cheaper) or Claude
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxx
# Claude (optional fallback): https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-xxx

# Volcengine / Doubao (Coding Plan): https://console.volcengine.com/ark
VOLCANO_ENGINE_API_KEY=your-volcengine-api-key

# NewsAPI.org (https://newsapi.org/register)
NEWSAPI_KEY=xxx

# NYTimes Article Search API (https://developer.nytimes.com/)
NYTIMES_API_KEY=xxx

# Buzzsprout API token (https://www.buzzsprout.com/account/api)
BUZZSPROUT_API_TOKEN=xxx

# HTTP Proxy (for accessing blocked APIs, e.g. http://127.0.0.1:7890)
# HTTP_PROXY=

# Optional: OpenAI TTS as fallback (better quality, paid)
# OPENAI_API_KEY=sk-xxx
